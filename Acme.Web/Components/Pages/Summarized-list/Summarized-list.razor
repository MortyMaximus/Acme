@page "/Summarized-list"
@using Acme.Models
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<PageTitle>Summarized list</PageTitle>

<h1>Summarized-list</h1>
<span>Here is a list over every submitted form.</span>
<br />
<br />
<table class="table">
    <thead>
        <tr>
            <th scope="col">
                <label onclick="@(() => Order(nameof(DrawModel.Email)))" style="cursor:pointer">E-mail</label>
            </th>
            <th scope="col">
                <label onclick="@(() => Order(nameof(DrawModel.FirstName)))" style="cursor:pointer">First name</label>
            </th>
            <th scope="col">
                <label onclick="@(() => Order(nameof(DrawModel.LastName)))" style="cursor:pointer">Last name</label>
            </th>
            <th scope="col">
                <label onclick="@(() => Order(nameof(DrawModel.SerialNumber)))" style="cursor:pointer">Serial number</label>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (PageData != null)
            foreach (var Models in Items)
            {
                <tr>
                    <td>@Models.Email</td>
                    <td>@Models.FirstName</td>
                    <td>@Models.LastName</td>
                    <td>@Models.SerialNumber</td>
                </tr>
            }
    </tbody>
</table>
@if (PageData != null)
{
    <div class="d-flex justify-content-between">
        <button class="btn btn-primary" @onclick="PrevPage" disabled="@(!PageData.HasPreviousPage)">Previous</button>
        <span>Page @PageData.PageIndex of @PageData.PageCount</span>
        <button class="btn btn-primary" @onclick="NextPage" disabled="@(!PageData.HasNextPage)">Next</button>
    </div>
}

@code {
    public Pagination<DrawModel> PageData { get; set; } = new Pagination<DrawModel>();
    int PageIndex { get; set; } = 1;
    int PageSize { get; set; } = 10;

    private List<DrawModel> Items { get; set; } = new List<DrawModel>();
    private HttpClient _httpClient;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("api");
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        PageData = await _httpClient.GetFromJsonAsync<Pagination<DrawModel>>($"draw/GetAll?pageSize={PageSize}&pageIndex={PageIndex}") ?? new Pagination<DrawModel>();
        Items = PageData?.Items?.ToList() ?? new List<DrawModel>();
    }

    private async Task PrevPage()
    {
        if (PageData.HasPreviousPage)
        {
            PageIndex--;
            await LoadPageAsync();
        }
    }
    private async Task NextPage()
    {
        if (PageData.HasNextPage)
        {
            PageIndex++;
            await LoadPageAsync();
        }
    }

    private void Order(string propertyName)
    {
        switch (propertyName)
        {
            case nameof(DrawModel.Email):
                Items = Items.OrderBy(m => m.Email).ToList();
                break;
            case nameof(DrawModel.FirstName):
                Items = Items.OrderBy(m => m.FirstName).ToList();
                break;
            case nameof(DrawModel.LastName):
                Items = Items.OrderBy(m => m.LastName).ToList();
                break;
            case nameof(DrawModel.SerialNumber):
                Items = Items.OrderBy(m => m.SerialNumber).ToList();
                break;
        }
    }
}